#include "rfid.h"

extern SPI_HandleTypeDef hspi1;

void MFRC522_CS_Enable(void) {
    HAL_GPIO_WritePin(MFRC522_CS_PORT, MFRC522_CS_PIN, GPIO_PIN_RESET);
}

void MFRC522_CS_Disable(void) {
    HAL_GPIO_WritePin(MFRC522_CS_PORT, MFRC522_CS_PIN, GPIO_PIN_SET);
}

void MFRC522_WriteRegister(uint8_t addr, uint8_t val) {
    MFRC522_CS_Enable();
    uint8_t buf[2] = { (addr << 1) & 0x7E, val };
    HAL_SPI_Transmit(&hspi1, buf, 2, HAL_MAX_DELAY);
    MFRC522_CS_Disable();
}

uint8_t MFRC522_ReadRegister(uint8_t addr) {
    uint8_t val;
    uint8_t buf[2] = { ((addr << 1) & 0x7E) | 0x80, 0 };
    MFRC522_CS_Enable();
    HAL_SPI_TransmitReceive(&hspi1, buf, buf, 2, HAL_MAX_DELAY);
    MFRC522_CS_Disable();
    val = buf[1];
    return val;
}

void MFRC522_SetBitMask(uint8_t reg, uint8_t mask) {
    uint8_t tmp = MFRC522_ReadRegister(reg);
    MFRC522_WriteRegister(reg, tmp | mask);
}

void MFRC522_ClearBitMask(uint8_t reg, uint8_t mask) {
    uint8_t tmp = MFRC522_ReadRegister(reg);
    MFRC522_WriteRegister(reg, tmp & (~mask));
}

void MFRC522_AntennaOn(void) {
    uint8_t temp = MFRC522_ReadRegister(0x14);
    if (!(temp & 0x03)) {
        MFRC522_SetBitMask(0x14, 0x03);
    }
}

void MFRC522_Init(void) {
    HAL_GPIO_WritePin(MFRC522_RST_PORT, MFRC522_RST_PIN, GPIO_PIN_SET);
    MFRC522_WriteRegister(0x01, 0x0F); // CommandReg = SoftReset
    HAL_Delay(50);
    MFRC522_WriteRegister(0x2A, 0x8D);
    MFRC522_WriteRegister(0x2B, 0x3E);
    MFRC522_WriteRegister(0x2D, 30);
    MFRC522_WriteRegister(0x2C, 0);
    MFRC522_WriteRegister(0x15, 0x40);
    MFRC522_WriteRegister(0x11, 0x3D);
    MFRC522_AntennaOn();
}

uint8_t MFRC522_Request(uint8_t reqMode, uint8_t *TagType) {
    MFRC522_WriteRegister(0x0D, 0x07); // BitFramingReg
    TagType[0] = reqMode;
    return MI_OK; // 실제 구현에서는 카드 응답 확인 필요
}

uint8_t MFRC522_Anticoll(uint8_t *serNum) {
    MFRC522_WriteRegister(0x0D, 0x00); // BitFramingReg
    // 실제 UID 읽기 구현 필요 (간략화됨)
    serNum[0] = 0xDE;
    serNum[1] = 0xAD;
    serNum[2] = 0xBE;
    serNum[3] = 0xEF;
    serNum[4] = 0x01;
    return MI_OK;
}
