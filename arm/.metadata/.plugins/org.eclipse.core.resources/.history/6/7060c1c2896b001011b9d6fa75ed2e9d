#include "rfid.h"

extern SPI_HandleTypeDef hspi1;

static void RC522_CS(uint8_t state) {
    HAL_GPIO_WritePin(RC522_CS_PORT, RC522_CS_PIN, state ? GPIO_PIN_SET : GPIO_PIN_RESET);
}

static void RC522_RST(uint8_t state) {
    HAL_GPIO_WritePin(RC522_RST_PORT, RC522_RST_PIN, state ? GPIO_PIN_SET : GPIO_PIN_RESET);
}

static uint8_t SPI_Transfer(uint8_t data) {
    uint8_t recv;
    HAL_SPI_TransmitReceive(&hspi1, &data, &recv, 1, HAL_MAX_DELAY);
    return recv;
}

void RC522_WriteRegister(uint8_t addr, uint8_t val) {
    uint8_t buffer[2];
    buffer[0] = ((addr << 1) & 0x7E);  // 주소: 마지막 비트 0 (쓰기)
    buffer[1] = val;

    RC522_CS(0);  // CS Low
    HAL_SPI_Transmit(&hspi1, buffer, 2, HAL_MAX_DELAY);
    RC522_CS(1);  // CS High
}

uint8_t RC522_ReadRegister(uint8_t addr) {
    RC522_CS(0);
    SPI_Transfer(((addr << 1) & 0x7E) | 0x80);
    uint8_t val = SPI_Transfer(0x00);
    RC522_CS(1);
    return val;
}

void RC522_SetBitMask(uint8_t reg, uint8_t mask) {
    uint8_t tmp = RC522_ReadRegister(reg);
    RC522_WriteRegister(reg, tmp | mask);
}

void RC522_ClearBitMask(uint8_t reg, uint8_t mask) {
    uint8_t tmp = RC522_ReadRegister(reg);
    RC522_WriteRegister(reg, tmp & (~mask));
}

void RC522_Reset(void) {
    RC522_WriteRegister(0x01, PCD_RESETPHASE);
}

void RC522_AntennaOn(void) {
    uint8_t temp = RC522_ReadRegister(0x14);
    if (!(temp & 0x03)) {
        RC522_SetBitMask(0x14, 0x03);
    }
}

void RC522_AntennaOff(void) {
    RC522_ClearBitMask(0x14, 0x03);
}

void RC522_Init(void) {
    RC522_RST(1);
    HAL_Delay(50);
    RC522_Reset();

    RC522_WriteRegister(0x2A, 0x8D);  // TModeReg
    RC522_WriteRegister(0x2B, 0x3E);  // TPrescalerReg
    RC522_WriteRegister(0x2D, 30);    // TReloadRegL
    RC522_WriteRegister(0x2C, 0);     // TReloadRegH
    RC522_WriteRegister(0x15, 0x40);  // TxASKReg
    RC522_WriteRegister(0x11, 0x3D);  // ModeReg

    RC522_AntennaOn();
}

uint8_t RC522_Request(uint8_t reqMode, uint8_t *TagType) {
    uint8_t status;
    uint8_t backBits;

    RC522_WriteRegister(0x0D, 0x07);  // BitFramingReg
    TagType[0] = reqMode;
    status = RC522_ToCard(PCD_TRANSCEIVE, TagType, 1, TagType, (uint32_t *)&backBits);
    return (status == MI_OK && backBits == 0x10) ? MI_OK : MI_ERR;
}

uint8_t RC522_ToCard(uint8_t command, uint8_t *sendData, uint8_t sendLen,
                     uint8_t *backData, uint32_t *backLen) {
    uint8_t status = MI_ERR;
    uint8_t irqEn = 0x00;
    uint8_t waitIRq = 0x00;
    uint8_t lastBits;
    uint8_t n;
    uint32_t i;

    if (command == PCD_AUTHENT) {
        irqEn = 0x12;
        waitIRq = 0x10;
    } else if (command == PCD_TRANSCEIVE) {
        irqEn = 0x77;
        waitIRq = 0x30;
    }

    RC522_WriteRegister(0x02, irqEn | 0x80); // CommIEnReg
    RC522_ClearBitMask(0x04, 0x80);          // CommIrqReg
    RC522_SetBitMask(0x0A, 0x80);            // FIFOLevelReg

    RC522_WriteRegister(0x01, PCD_IDLE);     // CommandReg

    for (i = 0; i < sendLen; i++) {
        RC522_WriteRegister(0x09, sendData[i]); // FIFODataReg
    }

    RC522_WriteRegister(0x01, command);

    if (command == PCD_TRANSCEIVE) {
        RC522_SetBitMask(0x0D, 0x80); // StartSend
    }

    i = 2000; // Timeout
    do {
        n = RC522_ReadRegister(0x04);
        i--;
    } while (i != 0 && !(n & 0x01) && !(n & waitIRq));

    RC522_ClearBitMask(0x0D, 0x80);

    if (i != 0) {
        if ((RC522_ReadRegister(0x06) & 0x1B) == 0x00) {
            status = MI_OK;

            if (n & irqEn & 0x01) {
                status = MI_NOTAGERR;
            }

            if (command == PCD_TRANSCEIVE) {
                n = RC522_ReadRegister(0x0A);
                lastBits = RC522_ReadRegister(0x0C) & 0x07;
                *backLen = (lastBits) ? ((n - 1) * 8 + lastBits) : (n * 8);

                for (i = 0; i < n; i++) {
                    backData[i] = RC522_ReadRegister(0x09);
                }
            }
        } else {
            status = MI_ERR;
        }
    }

    return status;
}

uint8_t RC522_Anticoll(uint8_t *serNum) {
    uint8_t status;
    uint8_t i;
    uint8_t serNumCheck = 0;
    uint32_t unLen;

    RC522_WriteRegister(0x0D, 0x00);
    serNum[0] = PICC_ANTICOLL;
    serNum[1] = 0x20;
    status = RC522_ToCard(PCD_TRANSCEIVE, serNum, 2, serNum, &unLen);

    if (status == MI_OK) {
        for (i = 0; i < 4; i++) {
            serNumCheck ^= serNum[i];
        }
        if (serNumCheck != serNum[4]) status = MI_ERR;
    }

    return status;
}

uint8_t RC522_SelectTag(uint8_t *serNum) {
    uint8_t i;
    uint8_t status;
    uint8_t recvBits;
    uint8_t buffer[9];

    buffer[0] = PICC_SELECTTAG;
    buffer[1] = 0x70;
    for (i = 0; i < 5; i++) {
        buffer[i + 2] = serNum[i];
    }

    // TODO: Add CRC calc

    status = RC522_ToCard(PCD_TRANSCEIVE, buffer, 7, buffer, (uint32_t *)&recvBits);
    return (status == MI_OK && recvBits == 0x18) ? MI_OK : MI_ERR;
}

uint8_t RC522_Check(uint8_t *id) {
    uint8_t status;
    status = RC522_Request(PICC_REQIDL, id);
    if (status == MI_OK) {
        status = RC522_Anticoll(id);
    }
    return status;
}

void RC522_Halt(void) {
    uint8_t buffer[4];

    buffer[0] = PICC_HALT;
    buffer[1] = 0;
    // TODO: Add CRC

    RC522_ToCard(PCD_TRANSCEIVE, buffer, 2, buffer, 0);
}
