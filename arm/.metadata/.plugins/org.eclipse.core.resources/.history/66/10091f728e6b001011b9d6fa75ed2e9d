#ifndef INC_RFID_H_
#define INC_RFID_H_

#include "main.h"
#include "stm32f4xx_hal.h"

#define MFRC522_CS_PORT GPIOC
#define MFRC522_CS_PIN GPIO_PIN_6
#define MFRC522_RST_PORT GPIOC
#define MFRC522_RST_PIN GPIO_PIN_8

// RC522 명령 코드 정의
#define PICC_REQIDL     0x26  // 카드가 대기 상태일 때 요청
#define PICC_REQALL     0x52  // 모든 카드 요청
#define PICC_ANTICOLL   0x93  // UID 충돌 방지
#define PICC_SELECTTAG  0x93  // 카드 선택
#define PICC_AUTHENT1A  0x60  // 인증 키 A
#define PICC_AUTHENT1B  0x61  // 인증 키 B
#define PICC_READ       0x30  // 블록 읽기
#define PICC_WRITE      0xA0  // 블록 쓰기
#define PICC_HALT       0x50  // 카드 정지

#define MFRC522_MAX_LEN 16
#define MI_OK 0
#define MI_ERR 1

void MFRC522_Init(void);
uint8_t MFRC522_Request(uint8_t reqMode, uint8_t *TagType);
uint8_t MFRC522_Anticoll(uint8_t *serNum);

#endif /* INC_RFID_H_ */
