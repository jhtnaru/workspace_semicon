// lcdtouch.c
#include "lcdtouch.h"

extern SPI_HandleTypeDef hspi2; // SPI2 for touch

static uint16_t X_raw, Y_raw;

void TP_Init(void) {
	TP_CS_HIGH();
}

static uint16_t TP_Read8(uint8_t cmd) {
	uint8_t tx[3] = {cmd, 0, 0};
	uint8_t rx[3] = {0};
	TP_CS_LOW();
	HAL_SPI_TransmitReceive(&hspi2, tx, rx, 3, HAL_MAX_DELAY);
	TP_CS_HIGH();
	uint16_t val = ((uint16_t)rx[1] << 8) | rx[2];
	return val >> 4;
}

uint8_t TP_Touched(void) {
    // Simple read on Z1/Z2 could be added; for now always return 1 if CS low read works
    return 1;
}

uint8_t TP_GetXY(uint16_t *x, uint16_t *y) {
	X_raw = TP_Read8(0x90); // X
	Y_raw = TP_Read8(0xD0); // Y
	// basic calibration (assumes X_raw [200..3800] -> [0..239], Y_raw [200..3800] -> [0..319])
	int32_t xr = X_raw;
	int32_t yr = Y_raw;
	if(xr < 200 || yr < 200) return 0;
//	*x = (uint16_t)((xr - 200) * 240 / (3800 - 200));
//	*y = (uint16_t)((yr - 200) * 320 / (3800 - 200));
	*x = (uint16_t)((xr - 250) * 240 / (1900 - 250));
	*y = (uint16_t)((yr - 250) * 320 / (2100 - 250));

	if (*x >= 240) *x = 239;
	else if (*x <= 10) *x = 10;

	if (*y >= 320) *y = 319;
	else if (*y <= 10) *y = 10;

	return 1;
}
