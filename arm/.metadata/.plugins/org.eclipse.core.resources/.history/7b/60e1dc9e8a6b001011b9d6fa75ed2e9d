#include "rfid.h"

void RC522_WriteRegister(uint8_t addr, uint8_t val) {
    uint8_t buffer[2];
    buffer[0] = (addr << 1) & 0x7E;  // 마지막 비트 0 = 쓰기
    buffer[1] = val;

    RC522_CS(0);
    HAL_SPI_Transmit(&hspi1, buffer, 2, HAL_MAX_DELAY);
    RC522_CS(1);
}

uint8_t RC522_ReadRegister(uint8_t addr) {
    uint8_t tx = ((addr << 1) & 0x7E) | 0x80;  // 마지막 비트 1 = 읽기
    uint8_t rx = 0;

    RC522_CS(0);
    HAL_SPI_Transmit(&hspi1, &tx, 1, HAL_MAX_DELAY);
    HAL_SPI_Receive(&hspi1, &rx, 1, HAL_MAX_DELAY);
    RC522_CS(1);

    return rx;
}

void RC522_SetBitMask(uint8_t reg, uint8_t mask) {
    uint8_t tmp = RC522_ReadRegister(reg);
    RC522_WriteRegister(reg, tmp | mask);
}

void RC522_ClearBitMask(uint8_t reg, uint8_t mask) {
    uint8_t tmp = RC522_ReadRegister(reg);
    RC522_WriteRegister(reg, tmp & (~mask));
}

void RC522_Reset(void) {
    RC522_WriteRegister(CommandReg, PCD_RESETPHASE);
}

void RC522_AntennaOn(void) {
    uint8_t temp = RC522_ReadRegister(TxControlReg);
    if (!(temp & 0x03)) {
        RC522_SetBitMask(TxControlReg, 0x03);
    }
}

void RC522_Init(void) {
    RC522_RST(1);
    HAL_Delay(50);
    RC522_Reset();

    RC522_WriteRegister(TModeReg, 0x8D);
    RC522_WriteRegister(TPrescalerReg, 0x3E);
    RC522_WriteRegister(TReloadRegL, 30);
    RC522_WriteRegister(TReloadRegH, 0);
    RC522_WriteRegister(TxASKReg, 0x40);
    RC522_WriteRegister(ModeReg, 0x3D);

    RC522_AntennaOn();
}

uint8_t RC522_Request(uint8_t reqMode, uint8_t *TagType) {
    uint8_t status;
    uint32_t backBits;
    uint8_t buf[2];

    RC522_WriteRegister(BitFramingReg, 0x07);  // TxLastBists = 7

    buf[0] = reqMode;

    status = RC522_ToCard(PCD_TRANSCEIVE, buf, 1, TagType, &backBits);

    if ((status != HAL_OK) || (backBits != 0x10)) {
        return HAL_ERROR;
    }

    return HAL_OK;
}

// 매우 간단화된 RC522_ToCard 구현 (디버깅 용도)
uint8_t RC522_ToCard(uint8_t command, uint8_t *sendData, uint8_t sendLen,
                     uint8_t *backData, uint32_t *backLen) {
    uint8_t status = HAL_ERROR;
    uint8_t irqEn = 0x77;
    uint8_t waitIRq = 0x30;
    uint8_t n, lastBits, i;

    RC522_WriteRegister(CommIrqReg, 0x7F); // IRQ 클리어
    RC522_SetBitMask(FIFOLevelReg, 0x80); // FIFO 초기화

    for (i = 0; i < sendLen; i++) {
        RC522_WriteRegister(FIFODataReg, sendData[i]);
    }

    RC522_WriteRegister(CommandReg, command);

    if (command == PCD_TRANSCEIVE) {
        RC522_SetBitMask(BitFramingReg, 0x80); // StartSend
    }

    // 대기
    i = 200;
    do {
        n = RC522_ReadRegister(CommIrqReg);
        i--;
    } while ((i != 0) && !(n & 0x01) && !(n & waitIRq));

    RC522_ClearBitMask(BitFramingReg, 0x80); // StopSend

    if (i != 0) {
        if (!(RC522_ReadRegister(ErrorReg) & 0x1B)) {
            status = HAL_OK;
            if (backData && backLen) {
                uint32_t len = RC522_ReadRegister(FIFOLevelReg);
                lastBits = RC522_ReadRegister(ControlReg) & 0x07;
                *backLen = len;
                for (i = 0; i < len; i++) {
                    backData[i] = RC522_ReadRegister(FIFODataReg);
                }
            }
        }
    }

    return status;
}
