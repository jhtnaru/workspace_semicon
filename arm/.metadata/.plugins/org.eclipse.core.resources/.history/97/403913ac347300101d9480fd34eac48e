// rtc.c
#include "rtc.h"

void gpioMode(GPIO_TypeDef *port, uint16_t pin, uint8_t mode) {
	GPIO_InitTypeDef GPIO_InitStruct = {0};

	// GPIO Output Mode 설정
	if(mode == OUTPUT) {
		GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
	}
	// GPIO Input Mode 설정
	else if(mode == INPUT) {
		GPIO_InitStruct.Mode = GPIO_MODE_INPUT;
	}

	GPIO_InitStruct.Pin = pin;
	GPIO_InitStruct.Pull = GPIO_NOPULL;
	GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_HIGH;
	HAL_GPIO_Init(port, &GPIO_InitStruct);
}

void rtcWrite(GPIO_TypeDef *clk_port, uint16_t clk_pin,
				GPIO_TypeDef *dat_port, uint16_t dat_pin, uint8_t value) {
	gpioMode(dat_port, dat_pin, OUTPUT);

	for (uint8_t i = 0; i < 8; i++) {
		if ((value & (0x01 << i)) == 0) {
			HAL_GPIO_WritePin(dat_port, dat_pin, GPIO_PIN_RESET);
		}
		else if ((value & (0x01 << i)) == 1) {
			HAL_GPIO_WritePin(dat_port, dat_pin, GPIO_PIN_SET);
		}
		HAL_GPIO_WritePin(clk_port, clk_pin, GPIO_PIN_SET);
		HAL_GPIO_WritePin(clk_port, clk_pin, GPIO_PIN_RESET);
	}
}

uint8_t rtcRead(GPIO_TypeDef *clk_port, uint16_t clk_pin,
				  GPIO_TypeDef *dat_port, uint16_t dat_pin) {
	gpioMode(dat_port, dat_pin, INPUT);

	uint8_t curBit = 0;
	uint8_t value = 0;

	for (uint8_t i = 0; i < 8; i++) {
		curBit = HAL_GPIO_ReadPin(dat_port, dat_pin);
		value |= (curBit << i);
		HAL_GPIO_WritePin(clk_port, clk_pin, GPIO_PIN_SET);
				HAL_GPIO_WritePin(clk_port, clk_pin, GPIO_PIN_RESET);
	}
}
